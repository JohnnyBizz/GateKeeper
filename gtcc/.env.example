# Grok Trading Command Center — environment template.
# Copy to .env. Never commit a filled-in copy.

# -- required outside development -------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GTCC_SECRET_KEY=

# -- mode. The defaults are deliberate: paper, no live, nothing automatic. --
#
# The startup mode. BACKTEST or PAPER only; GTCC_MODE=LIVE is REFUSED.
# Live execution is not a mode you configure, it is a state a person
# arms at runtime, so that a restart can never resume it by itself.
GTCC_MODE=PAPER
#
# DEPLOYMENT PERMISSION, not activation. True means this server is
# allowed to OFFER live mode in its interface. It arms nothing: after
# every restart the process comes back with live disarmed, and a signed-in
# owner must POST /api/control/live/arm with the exact phrase
# "ENABLE LIVE TRADING" to arm it.
#
# There is deliberately no environment variable that carries the
# confirmation phrase. An earlier version had one, which meant a stale
# variable in a deploy environment satisfied the human-confirmation gate
# at boot.
GTCC_ALLOW_LIVE_TRADING=false
#
# Whether strategies may submit without a person pressing anything.
# Independent of live: automatic paper execution is a real mode.
GTCC_AUTOMATIC_EXECUTION=false

# -- storage -----------------------------------------------------------------
GTCC_DATABASE_URL=sqlite:///./gtcc.db
# GTCC_DATABASE_URL=postgresql+psycopg://gtcc:password@localhost:5432/gtcc
# Needed only to rate-limit across more than one instance.
GTCC_REDIS_URL=

# -- risk. Your numbers, not ours. Copy config/risk.example.yaml first. ------
GTCC_RISK_CONFIG_PATH=config/risk.yaml

# -- web ---------------------------------------------------------------------
GTCC_ENVIRONMENT=development
# Set false only for local http development: a secure cookie will not
# travel over plain http, so sign-in appears to fail without it.
GTCC_SECURE_COOKIES=true
GTCC_SESSION_MAX_AGE_SECONDS=28800
GTCC_LOGIN_RATE_LIMIT_PER_MINUTE=5

# -- data quality gates ------------------------------------------------------
GTCC_MAX_QUOTE_AGE_SECONDS=5
GTCC_MAX_CLOCK_SKEW_SECONDS=2

# -- Grok / xAI (Phase 3) ----------------------------------------------------
GTCC_GROK_API_KEY=
# No default: model identifiers go stale and a stale one fails at the worst
# moment. Set this from current xAI documentation.
GTCC_GROK_MODEL=
GTCC_GROK_TIMEOUT_SECONDS=30
GTCC_REQUIRE_GROK_FOR_TRADES=false

# -- OANDA ---------------------------------------------------------------------
#
# A v20 personal access token. Generate it yourself from your OANDA
# account's API access page; it is NOT your username and password, and
# nobody but this server should ever see it.
#
# Keep it in this file or in a secret manager, never in a chat, a ticket
# or a commit. .env is gitignored.
GTCC_OANDA_TOKEN=
#
# The account to trade, in the form 101-004-1234567-001. Visible on the
# same page as the token.
GTCC_OANDA_ACCOUNT_ID=
#
# "practice" or "live". Practice uses simulated funds against real
# prices and is what Phase 2 is for. Pointing at live additionally
# requires GTCC_ALLOW_LIVE_TRADING and a runtime arming, so setting
# this to "live" on its own does not reach a real account.
GTCC_OANDA_ENVIRONMENT=practice
GTCC_OANDA_TIMEOUT_SECONDS=10
GTCC_OANDA_REQUESTS_PER_SECOND=20

# -- logging -----------------------------------------------------------------
GTCC_LOG_LEVEL=INFO
GTCC_LOG_FORMAT=json
